# Public site URL (used by sitemap.xml / robots.txt / OG image absolute URLs)
NEXT_PUBLIC_SITE_URL=https://nenshu-jiten.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (企業概要生成用)
ANTHROPIC_API_KEY=

# EDINET
EDINET_API_KEY=

# gBizINFO (経済産業省 法人情報 API)
# https://info.gbiz.go.jp/api/index.html で利用登録 → 発行された API Token を貼る
# scripts/etl/07-import-gbizinfo.ts で使用（HP・設立年月日・資本金・代表者の取得）
GBIZINFO_API_TOKEN=

# 管理画面 (/admin) を閲覧できる管理者の email アドレス（カンマ区切り、複数可）
# 例: ADMIN_EMAILS=ops@example.com,oncall@example.com
# 大文字小文字は内部で正規化されます。空のままだと誰も admin になれません。
ADMIN_EMAILS=
